<ci:SettingsPageBase x:Class="QqClassSync.Views.TiaokeSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="600">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="4">

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ci:FluentIcon FontSize="48"
                              Glyph="&#xE02B;"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="SemiBold">QQ 调课同步</TextBlock>
                    <TextBlock FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        监听 QQ 群聊 / 私聊里的「#调课」消息，自动给临时层课表打补丁
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- 监听设置 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,12,0,0">
                监听
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE72A;}"
                                       Header="启用监听"
                                       Description="关闭后不再轮询 Windows 通知中心">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE70F;}"
                                       Header="触发关键词"
                                       Description="消息里包含这个词才会被解析，默认 #调课">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding Keyword, Mode=TwoWay}"
                             Width="160"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE916;}"
                                       Header="轮询间隔（秒）"
                                       Description="Windows 通知中心没有事件通知，只能轮询；建议 1 秒">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding ScanIntervalDisplay, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 行为设置 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                行为
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE73E;}"
                                       Header="自动应用调课"
                                       Description="关闭后只发提醒、不改课表（干跑模式，适合先验证解析）">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding AutoApply, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xEA39;}"
                                       Header="解析失败也提醒"
                                       Description="消息格式不符时弹提示，方便老师调整说法">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding NotifyOnParseFailure, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- AI 模糊解析 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                AI 模糊解析（实验性）
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE99A;}"
                                       Header="启用 AI 解析"
                                       Description="把自然语言调课交给大模型解析；未填 Key 时自动回退正则解析">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding AiEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE8D7;}"
                                       Header="发送前确认"
                                       Description="AI 解析出的调课只提醒、不直接执行（防误判，也少把消息发出去）">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding AiConfirmBeforeSend, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE72E;}"
                                       Header="API Key"
                                       Description="只保存在本机 Settings.json；留空则完全走正则解析，不会报错">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding AiApiKey, Mode=TwoWay}"
                             PasswordChar="●"
                             Width="280"
                             HorizontalAlignment="Right"
                             Watermark="sk-..." />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE774;}"
                                       Header="API Base URL"
                                       Description="默认 https://api.deepseek.com/v1">
                <controls:SettingsExpander.Footer>
                    <TextBox Text="{Binding AiBaseUrl, Mode=TwoWay}"
                             Width="320"
                             HorizontalAlignment="Right" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <TextBlock x:Name="AiStatusText"
                       FontSize="12"
                       Margin="4,4,0,12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!-- 调课操作 -->
            <TextBlock FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,20,0,0">
                调课操作
            </TextBlock>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE8A5;}"
                                       Header="今天生效的课表"
                                       Description="调课补丁只会写进今天的临时层">
                <controls:SettingsExpander.Footer>
                    <TextBlock x:Name="PlanStatusText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="正在读取…" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE7A7;}"
                                       Header="撤销今天的调课"
                                       Description="清除今天的临时层课表，恢复原课表；也可以发「#撤销调课」">
                <controls:SettingsExpander.Footer>
                    <Button x:Name="UndoButton" Click="OnUndoClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ci:FluentIcon Glyph="&#xE7A7;" />
                            <TextBlock Text="撤销全部" />
                        </StackPanel>
                    </Button>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource Glyph=&#xE71D;}"
                                       Header="撤销单节课 / 批量撤销"
                                       Description="只把指定节次恢复成原科目，其他调课保留；可填 3 或 3,5。也可以发「#撤销调课 第3,5节」">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="LessonInput"
                                 Width="90"
                                 VerticalAlignment="Center"
                                 Watermark="3 或 3,5" />
                        <Button Click="OnUndoLessonClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ci:FluentIcon Glyph="&#xE71D;" />
                                <TextBlock Text="撤销这些节" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <TextBlock x:Name="UndoStatusText"
                       FontSize="12"
                       Margin="4,4,0,12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
